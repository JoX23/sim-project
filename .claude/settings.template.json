{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Plantilla de referencia con tier enforcement completo. NO se aplica automáticamente — Claude Code gestiona settings.json desde acciones aprobadas en sesión. Copia secciones de aquí a settings.json o settings.local.json según necesidad.",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)",
      "Bash(bash scripts/harness-test.sh:*)",
      "Bash(bash scripts/tickets-aggregate.sh:*)",
      "mcp__lean-ctx__*"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(rm -rf:*)",
      "Read(.env*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm publish:*)",
      "Bash(pip publish:*)",
      "Bash(cargo publish:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-tool.sh"
          }
        ]
      }
    ]
  }
}
